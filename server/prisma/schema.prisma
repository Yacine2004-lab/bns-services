datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------------
// 1. CATÉGORIES ET SOUS-CATÉGORIES
// --------------------------------------------------------

model Category {
  id            String         @id
  name          String         @unique
  slug          String         @unique
  icon          String?
  image         String?
  description   String?
  subCategories SubCategory[]
  products      Product[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("categories")
}

model SubCategory {
  id         String    @id
  name       String
  slug       String
  icon       String?
  image      String?
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([categoryId, slug])
  @@map("sub_categories")
}

// --------------------------------------------------------
// 2. PRODUITS
// --------------------------------------------------------

model Product {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  description   String       @db.Text
  price         Float
  image         String
  images        String[]     @default([])
  reference     String       @unique
  stock         Int          @default(0)
  rating        Float        @default(0)
  featured      Boolean      @default(false)
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])
  subCategoryId String
  subCategory   SubCategory  @relation(fields: [subCategoryId], references: [id])
  orderItems    OrderItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("products")
}

// --------------------------------------------------------
// 3. AUTHENTIFICATION CLIENTS
// --------------------------------------------------------

model Customer {
  id                   String    @id @default(uuid())
  firstName            String
  lastName             String
  email                String    @unique
  phone                String?
  password             String
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  orders               Order[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("customers")
}

// --------------------------------------------------------
// 4. AUTHENTIFICATION ADMINISTRATEURS (ISOLÉE)
// --------------------------------------------------------

model AdminUser {
  id                   String    @id @default(uuid())
  email                String    @unique
  password             String
  name                 String    @default("Administrateur")
  role                 String    @default("admin")
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("admin_users")
}

// --------------------------------------------------------
// 5. COMMANDES ET ARTICLES COMMANDÉS
// --------------------------------------------------------

enum OrderStatus {
  PENDING    // En attente
  CONFIRMED  // Confirmée
  SHIPPED    // En cours de livraison
  DELIVERED  // Livrée
  CANCELLED  // Annulée
}

enum PaymentMethod {
  CASH_ON_DELIVERY // Paiement à la livraison
  WAVE             // Wave Mobile Money
  ORANGE_MONEY     // Orange Money
}

enum PaymentStatus {
  PENDING // En attente
  PAID    // Payé
  FAILED  // Échoué
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique // Ex: CMD-123456
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  // Coordonnées de livraison (remplies pour client ou invité)
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String        @db.Text
  shippingCity    String
  shippingNotes   String?       @db.Text
  
  // États et montants
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus   PaymentStatus @default(PENDING)
  
  subtotal        Float
  shippingFee     Float         @default(0)
  total           Float
  
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("orders")
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName      String
  productReference String?
  productImage     String?
  productPrice     Float    // Prix unitaire figé au moment de la commande
  quantity         Int
  total            Float
  createdAt        DateTime @default(now())

  @@map("order_items")
}
