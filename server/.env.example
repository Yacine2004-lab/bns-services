# Environnement : "development" en local, "production" sur le serveur
NODE_ENV=development

# Port du serveur Express
PORT=5000

# URL du frontend autorisé pour CORS
CLIENT_URL=http://localhost:5173

# Clés secrètes JWT — GENEREZ des chaînes aléatoires fortes en production
# Exemple : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_CUSTOMER_SECRET=change_me_with_a_long_random_string
JWT_ADMIN_SECRET=change_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Connexion PostgreSQL (Prisma)
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bns_services_db?schema=public"

# Configuration email (Brevo — gratuit 300 emails/jour)
# 1. Cree un compte sur https://www.brevo.com
# 2. Va dans SMTP & API > genere une cle SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ton-email-brevo@exemple.com
SMTP_PASS=ta-cle-smtp-brevo

# --------------------------------------------------------
# Authentification OAuth (Google + Facebook) — OPTIONNEL
# Tant que ces variables ne sont pas renseignees, les boutons
# "Continuer avec Google" et "Continuer avec Facebook" sont
# automatiquement desactives sur la page de connexion.
# --------------------------------------------------------

# Google OAuth 2.0
# 1. Va sur https://console.cloud.google.com/apis/credentials
# 2. Cree un identifiant OAuth 2.0 (type Web application)
# 3. Ajoute ces URLs de redirection autorisees :
#    - http://localhost:5000/api/auth/google/callback  (dev)
#    - https://bns-api-production.up.railway.app/api/auth/google/callback  (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth
# 1. Va sur https://developers.facebook.com/apps
# 2. Ajoute le produit "Facebook Login"
# 3. Ajoute ces URLs de redirection autorisees :
#    - http://localhost:5000/api/auth/facebook/callback  (dev)
#    - https://bns-api-production.up.railway.app/api/auth/facebook/callback  (prod)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
