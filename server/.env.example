NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Secrets JWT
JWT_CUSTOMER_SECRET=change_me_customer_secret
JWT_ADMIN_SECRET=change_me_admin_secret
JWT_EXPIRES_IN=7d

# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/bns_services_db?schema=public"

# OAuth Google (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Production VPS ---
# NODE_ENV=production
# PORT=3006
# CLIENT_URL=https://bayeniassservice.com
# GOOGLE_CLIENT_ID=1088793644931-....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...

# Origines CORS supplementaires (separees par des virgules, en plus des origines de base)
# ALLOWED_ORIGINS=https://autre-domaine.com,https://staging.bayeniassservice.com
