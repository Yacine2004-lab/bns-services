# Environnement : "development" en local, "production" sur le serveur
NODE_ENV=development

# Port du serveur Express
PORT=5000

# URL du frontend autorisé pour CORS
CLIENT_URL=http://localhost:5173

# Clés secrètes JWT — GENEREZ des chaînes aléatoires fortes en production
# Exemple : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_CUSTOMER_SECRET=change_me_with_a_long_random_string
JWT_ADMIN_SECRET=change_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Connexion PostgreSQL (Prisma)
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bns_services_db?schema=public"

# Configuration email (Brevo — gratuit 300 emails/jour)
# 1. Cree un compte sur https://www.brevo.com
# 2. Va dans SMTP & API > genere une cle SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ton-email-brevo@exemple.com
SMTP_PASS=ta-cle-smtp-brevo
